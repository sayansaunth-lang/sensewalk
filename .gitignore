# Python (Raspberry Pi side)
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
.venv-dev/
env/
.env

# PlatformIO / Arduino (ESP32 side)
.pio/
.pioenvs/
.piolibdeps/
*.hex
*.bin
build/

# Model weights & large binary assets (track via releases or shared drive instead)
*.caffemodel
*.pb
*.tflite
*.weights
*.pt
*.onnx

# Video / large media test captures
*.mp4
*.avi
*.mov
test/data/*.mp4
test/data/*.avi

# CAD autosave / temp files
*.f3d.lock
~$*

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Secrets
*.env
secrets.*

# Training artefacts (large, reproducible) — see training/README.md.
# The *exported* hazard model is the one deliberate exception below.
training/runs/
training/**/*.pt
!vision/pi/models/hazard_yolov8n_320.onnx

# Downloaded by vision/pi/models/*.sh, not committed
vision/pi/models/MobileNetSSD_deploy.prototxt
vision/pi/models/coco_labelmap.txt

# ultralytics validation output (created in the working dir by best.val())
runs/
